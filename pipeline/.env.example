# Copy to .env and fill in.

# Local paths
VOV_PIPELINE_DB=/var/lib/vov/pipeline.sqlite3
VOV_PIPELINE_PHOTOS=/var/lib/vov/photos/staging
VOV_PIPELINE_ARTIFACTS=/var/lib/vov/artifacts

# Anthropic — for the LLM auto-filter
ANTHROPIC_API_KEY=

# Cloudflare R2 — for publishing models + manifest
R2_BUCKET=vov-models
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_MANIFEST_KEY=vision/manifest.json
PUBLIC_BASE=https://models.valetops.com/vision/

# Wikimedia tunables
VOV_WIKIMEDIA_MAX=10
